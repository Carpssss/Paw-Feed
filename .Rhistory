# --------------------- LIBRARIES ---------------------
library(shiny)
library(DBI)
library(RMySQL)
library(pool) # Essential for database management
# --------------------- DATABASE CONNECTION ---------------------
# Database connection pool setup
pool <- dbPool(
RMySQL::MySQL(),
dbname = "pet_feeding_db",
host = "localhost",
user = "root",
password = "Jamil123#"
)
# Crucial: Ensure the connection pool is closed when the Shiny app stops
onStop(function() {
poolClose(pool)
print("✅ Database connection pool closed.")
})
# Informational check (This check is often unreliable for pool objects, but fine for now)
if (!is.null(pool)) {
print("/ Database connection object created.")
} else {
print("X Database connection failed!")
}
# --------------------- USER INTERFACE (UI) ---------------------
ui <- fluidPage(
# Fix: Ensure the file path and case sensitivity are 100% correct.
# If the file is named Fone.css (mixed case) on your system, use that name here.
# I've used 'fone.css' as a common convention, but check your filename!
includeCSS("www/Fone.css"),
# ... rest of your UI code is correct ...
div(class = "card",
h2("Paw Feed"),
div(class="emojis", "🐶 🐱 🐰"),
h3("No pets added yet!"),
p("Start by adding your pet to track feeding schedules and reminders."),
actionButton("add_pet", "+ Add Pet Sched", class = "btn-purple")
)
)
source('D:/RProject/Pet Feeding Log.R')
